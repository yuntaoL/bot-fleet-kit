{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "bot.json (0.10.5+): one bot's identity and environment; prompts and routines reference it instead of copying it",
 "type": "object",
 "required": ["schemaVersion", "display_name", "slug", "role", "agent_id", "worktree", "owner_name", "kit_version", "timezone"],
 "additionalProperties": false,
 "properties": {
  "schemaVersion": {"type": "integer", "const": 1},
  "display_name": {"type": "string", "minLength": 1},
  "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
  "role": {"enum": ["manager", "builder", "worker", "retired"]},
  "title": {"type": "string"},
  "agent_id": {"type": "string"},
  "worktree": {"type": "string", "minLength": 1},
  "owner_name": {"type": "string", "minLength": 1},
  "fleet_repo": {"type": "string"},
  "kit_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
  "timezone": {"type": "string", "minLength": 1}
 }
}
